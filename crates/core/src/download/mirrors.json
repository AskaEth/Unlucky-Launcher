      "enabled": false
    },
    {
      "id": "zju",
      "name": "浙大 ZJU（无 Adoptium 目录树，实测 404 搜索页）",
      "base": "https://mirrors.zju.edu.cn/adoptium",
      "enabled": false
    },
    {
      "id": "163",
      "name": "网易 163（无 Adoptium 目录树，实测 404 且 18 秒才回）",
      "base": "https://mirrors.163.com/adoptium",
      "enabled": false
    }
  ],
  "oracle_openjdk": [
    {
      "id": "huawei",
      "name": "华为云",
      "base": "https://mirrors.huaweicloud.com/openjdk",
      "enabled": true,
      "speed": "11.5MB/s",
      "note": "逐字节忠实镜像（21.0.2 = 201328186 B 与官方一致）；目录页是 Apache 列表，带 <pre>；归档旁有 .sha256"
    },
    {
      "id": "nju",
      "name": "南大 NJU",
      "base": "https://mirror.nju.edu.cn/openjdk",
      "enabled": true,
      "speed": "8.3MB/s",
      "note": "需先吃一次 bcheck cookie（裸 GET 是 302 回自己）；健康度会把它排在华为云之后，失败即降级"
    }
  ],
  "microsoft_openjdk": {
    "list": "https://learn.microsoft.com/java/openjdk/download",
    "template": "https://aka.ms/download-jdk/microsoft-jdk-{version}-{os}-{arch}.zip",
